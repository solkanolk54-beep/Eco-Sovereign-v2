// offline.ts — صندوق صادر محلي (IndexedDB) للبلاغات الميدانية دون اتصال.
// كل عنصر: { url, body } فيمكن لنفس المنطق أن يعمل في الصفحة وفي الـ Service Worker.

const DB_NAME = 'eco-offline';
const STORE = 'outbox';

export interface OutboxItem {
  id?: number;
  url: string;
  body: Record<string, unknown>;
  queuedAt: string;
}

export type FlushResult = { sent: number; rejected: number; remaining: number };

function openDb(): Promise<IDBDatabase> {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, 1);
    req.onupgradeneeded = () =>
      req.result.createObjectStore(STORE, { keyPath: 'id', autoIncrement: true });
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}

function tx<T>(mode: IDBTransactionMode, fn: (s: IDBObjectStore) => IDBRequest<T>): Promise<T> {
  return openDb().then(
    (db) =>
      new Promise<T>((resolve, reject) => {
        const req = fn(db.transaction(STORE, mode).objectStore(STORE));
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      }),
  );
